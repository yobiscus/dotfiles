(deflayer M_Base
  @esc
  XX     q      w      f      p      b      XX     j      l      u      y      '      XX     XX
  XX     @a_met @r_alt @s_ctl @t_sft g      XX     m      @n_sft @e_ctl @i_alt @o_met XX     XX
  XX     z      x      c      d      v      XX     k      h      ,      .      /      XX
  XX     XX     @esc_M @spc_N tab    XX     XX     @ent_S @bsp_M @del_F XX     XX
  XX     XX     XX                   XX                   XX     XX     XX
)

(deflayer M_Tap
  @esc
  XX     q      w      f      p      b      XX     j      l      u      y      '      XX     XX
  XX     a      r      s      t      g      XX     m      n      e      i      o      XX     XX
  XX     z      x      c      d      v      XX     k      h      ,      .      /      XX
  XX     XX     esc    spc    tab    XX     XX     ent    bspc   del    XX     XX
  XX     XX     XX                   XX                   XX     XX     XX
)

(deflayer M_Nav
  @esc
  XX     XX     @l_tap XX     XX     XX     XX     again  S-ins  C-ins  S-del  undo   XX     XX
  XX     met    alt    ctl    sft    XX     XX     caps   left   down   up     right  XX     XX
  XX     XX     XX     XX     XX     XX     XX     ins    home   pgdn   pgup   end    XX
  XX     XX     XX     XX     XX     XX     XX     @ent_S @bsp_M @del_F XX     XX
  XX     XX     XX                   XX                   XX     XX     XX
)

(deflayer M_Media
  @esc
  XX     XX     XX     XX     XX     XX     XX     XX     XX     XX     XX     XX     XX     XX
  XX     met    alt    ctl    sft    XX     XX     XX     @psong vold   volu   @nsong XX     XX
  XX     XX     XX     XX     XX     XX     XX     XX     XX     XX     XX     XX     XX
  XX     XX     XX     XX     XX     XX     XX     stopcd @plapa mute   XX     XX
  XX     XX     XX                   XX                   XX     XX     XX
)

(deflayer M_Num
  @esc
  XX     [      7      8      9      ]      XX     XX     XX     XX     XX     XX     XX     XX
  XX     ;      4      5      6      =      XX     XX     sft    ctl    alt    met    XX     XX
  XX     `      1      2      3      \\     XX     XX     XX     XX     XX     XX     XX
  XX     XX     .      0      -      XX     XX     XX     XX     XX     XX     XX
  XX     XX     XX                   XX                   XX     XX     XX
)

(deflayer M_Sym
  @esc
  XX     {      &      *      \(     }      XX     XX     XX     XX     XX     XX     XX     XX
  XX     :      $      %      ^      +      XX     XX     sft    ctl    alt    met    XX     XX
  XX     ~      !      @      #      |      XX     XX     XX     XX     XX     XX     XX
  XX     XX     \(     \)     \_     XX     XX     XX     XX     XX     XX     XX
  XX     XX     XX                   XX                   XX     XX     XX
)

(deflayer M_Fun
  @esc
  XX     _      _      _      _      _      XX     _      _      _      _      _      XX     XX
  XX     _      _      _      _      _      XX     _      _      _      _      _      XX     XX
  XX     -      _      _      _      _      XX     _      _      _      _      _      XX
  XX     XX     _      _      _      XX     XX     _      _      _      XX     XX
  XX     XX     XX                   XX                   XX     XX     XX
)

(deflayer control_panel
  -
  _    @ly1 @ly2 @ly3 -    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)

