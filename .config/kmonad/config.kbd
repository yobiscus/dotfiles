(defcfg
  ;; Lenovo ThinkPad X1 Carbon keyboard:
  input (device-file "/dev/input/by-path/platform-i8042-serio-0-event-kbd")
  ;; Ducky One keyboard:
  ;; input (device-file "/dev/input/by-path/pci-0000:00:14.0-usb-0:6.2.1.2:1.0-event-kbd")
  output (uinput-sink "KMonad output")
  ;; Undefined keys work as-is
  fallthrough true
  ;; Allow arbitrary commands:
  ;;   - Changes i3 layout when switching between colemak and qwerty
  allow-cmd true
)

(defsrc
  esc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defalias
  ;; Control Panel Layer
  esc (tap-hold-next-release 200 (around esc (pause 35)) (layer-toggle control_panel))
  ly1 (tap-macro (layer-switch qwerty)
                 (cmd-button "${XDG_CONFIG_HOME:-$HOME/.config}/i3/swplyt.sh qwerty"))
  ly2 (tap-macro (layer-switch colemak_dh)
                 (cmd-button "${XDG_CONFIG_HOME:-$HOME/.config}/i3/swplyt.sh colemak"))
  ly3 (tap-macro (layer-switch M_Base)
                 (cmd-button "${XDG_CONFIG_HOME:-$HOME/.config}/i3/swplyt.sh colemak"))
)

(deflayer qwerty
  @esc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lalt lmet           spc            ralt rmet rctl
)

(deflayer colemak_dh
  @esc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    f    p    b    j    l    u    y    ;    [    ]    \
  caps a    r    s    t    g    m    n    e    i    o    '    ret
  lsft x    c    d    v    z    k    h    ,    .    /    rsft
  lctl lalt lmet           spc            ralt rmet rctl
)

;; MIRYOKU layout

(defalias
  ;; GACS homerow mods
  a_met (tap-hold-next-release 200 a met)
  r_alt (tap-hold-next-release 200 r alt)
  s_ctl (tap-hold-next-release 200 s ctl)
  t_sft (tap-hold-next-release 200 t sft)
  n_sft (tap-hold-next-release 200 n sft)
  e_ctl (tap-hold-next-release 200 e ctl)
  i_alt (tap-hold-next-release 200 i alt)
  o_met (tap-hold-next-release 200 o met)

  ;; Thumb keys
  spc_N (tap-hold-next-release 200 spc  (layer-toggle M_Nav))
  ;; tab_M (tap-hold-next-release 200  (layer-toggle U_Mouse))
  esc_M (tap-hold-next-release 200 esc  (layer-toggle M_Media))
  bsp_M (tap-hold-next-release 200 bspc (layer-toggle M_Num))
  ent_S (tap-hold-next-release 200 ent  (layer-toggle M_Sym))
  del_F (tap-hold-next-release 200 del  (layer-toggle M_Fun))

  ;; Media aliases
  psong previoussong
  nsong nextsong
  plapa playpause

  ;; Extra layers
  l_tap (multi-tap 200 XX (layer-switch M_Tap))
)

